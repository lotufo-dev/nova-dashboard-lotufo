      "PowerShell(git switch *)",
      "PowerShell(git worktree *)",
      "PowerShell(gh pr *)",
      "PowerShell(gh issue *)",
      "PowerShell(gh run *)",
      "PowerShell(gh api *)",
      "PowerShell(gh pr merge *)",
      "PowerShell(.\\.venv\\Scripts\\python -m pytest *)",
      "PowerShell(.\\.venv\\Scripts\\python.exe -m pytest *)",
      "PowerShell(.\\backend\\.venv\\Scripts\\python -m pytest *)",
