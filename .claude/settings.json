      "PowerShell(backend/.venv/Scripts/python.exe -m pytest *)",
      "PowerShell(npm test *)",
      "PowerShell(npm run lint *)",
      "PowerShell(npm run typecheck *)",
      "PowerShell(npm run build *)",
      "PowerShell(npx tsc *)",
      "PowerShell(npx oxlint *)",
      "PowerShell(ruff *)",
      "PowerShell(python -m ruff *)",
      "PowerShell(.venv/Scripts/ruff *)",
