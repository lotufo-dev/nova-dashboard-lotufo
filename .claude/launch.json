{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend-dev",
      "runtimeExecutable": "powershell",
      "runtimeArgs": ["-NoProfile", "-Command", "$env:DASH_DEV='1'; $env:DASH_SEM_JOBS='1'; $env:DASH_GRAPH_SIMULADOR='dados/correio-simulado'; Set-Location backend; .venv\\Scripts\\python -m uvicorn --factory app.main:create_app --port 8080"],
      "port": 8080
    },
    {
      "name": "frontend-dev",
      "runtimeExecutable": "powershell",
      "runtimeArgs": ["-NoProfile", "-Command", "Set-Location frontend; npm run dev"],
      "port": 5173
    },
    {
      "name": "prototipo-login",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "http.server", "8777", "--directory", "prototipos/login-3d"],
      "port": 8777
    },
    {
      "name": "backend-dev-mac",
      "runtimeExecutable": "sh",
      "runtimeArgs": ["-c", "cd backend && DASH_DEV=1 DASH_SEM_JOBS=1 DASH_GRAPH_SIMULADOR=dados/correio-simulado exec .venv/bin/python -m uvicorn --factory app.main:create_app --port 8080"],
      "port": 8080
    },
    {
      "name": "frontend-dev-mac",
      "runtimeExecutable": "sh",
      "runtimeArgs": ["-c", "cd frontend && exec npm run dev"],
      "port": 5173
    },
    {
      "name": "prototipo-login-mac",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "http.server", "8777", "--directory", "prototipos/login-3d"],
      "port": 8777
    },
    {
      "name": "prototipos",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "http.server", "8778", "--bind", "127.0.0.1", "--directory", "prototipos"],
      "port": 8778
    },
    {
      "name": "prototipos-mac",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "http.server", "8778", "--bind", "127.0.0.1", "--directory", "prototipos"],
      "port": 8778
    }
  ]
}
